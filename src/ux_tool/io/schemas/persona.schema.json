{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "age", "segment"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "age": {"type": "integer", "minimum": 15, "maximum": 90},
    "gender": {"enum": ["female", "male", "nonbinary", "other"]},
    "segment": {"enum": ["early", "mainstream", "pro"]},
    "background": {"type": "string"},
    "occupation": {"type": "string"},
    "location": {"type": "string"},
    "household_size": {"type": "integer", "minimum": 1, "maximum": 10},
    "income_monthly": {"type": "number", "minimum": 0},
    "spend_monthly": {"type": "number", "minimum": 0},
    "spend_breakdown": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "traits": {"type": "object", "additionalProperties": {"type": "string"}},
    "goals": {"type": "array", "items": {"type": "string"}},
    "pains": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}


